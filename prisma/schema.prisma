generator client {
  provider = "prisma-client"
  output   = "../generated"
  runtime = "deno"
}

datasource db {
  //provider = "sqlite"
  //url      = "file:../movie.db"
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Movie {
  id     Int    @id @default(autoincrement())
  name   String
  year Int
  rating Float
}